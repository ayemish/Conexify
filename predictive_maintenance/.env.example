# PDM Configuration - Copy to .env and customize

# Environment
PDM_ENVIRONMENT=development
PDM_DEBUG=false
PDM_SITE_ID=site_001

# Database (PostgreSQL)
PDM_DB_HOST=localhost
PDM_DB_PORT=5432
PDM_DB_NAME=pdm
PDM_DB_USER=pdm_user
PDM_DB_PASSWORD=changeme
PDM_DB_POOL_SIZE=5
PDM_DB_MAX_OVERFLOW=10

# Redis
PDM_REDIS_HOST=localhost
PDM_REDIS_PORT=6379
PDM_REDIS_PASSWORD=
PDM_REDIS_DB=0
PDM_REDIS_SSL=false
PDM_REDIS_EVENT_TTL=86400
PDM_REDIS_DLQ_TTL=604800

# API Server
PDM_API_HOST=0.0.0.0
PDM_API_PORT=8000
PDM_API_WORKERS=4
PDM_API_RELOAD=false
PDM_API_KEY_HEADER=X-API-Key
PDM_API_KEYS=dev-key-1,dev-key-2
PDM_CORS_ORIGINS=*
PDM_RATE_LIMIT_REQUESTS=100
PDM_RATE_LIMIT_WINDOW=60

# False Positive Budget
PDM_FP_MAX_ALARMS_PER_MONTH=0.3
PDM_FP_MAX_NIF_RATE=0.05
PDM_FP_MIN_CONFIDENCE=0.85
PDM_FP_MAX_FA_PROB=0.02
PDM_FP_MIN_PERSISTENCE_HOURS=6.0
PDM_FP_MIN_REGIME_CYCLES=2

# Change Detection
PDM_CD_CUSUM_THRESHOLD=5.0
PDM_CD_CUSUM_SLACK=0.5
PDM_CD_GLR_THRESHOLD=10.0
PDM_CD_MIN_PERSISTENCE=360.0
PDM_CD_MIN_REGIMES=2
PDM_CD_STABILITY_WINDOW=50

# Logging
PDM_LOG_LEVEL=INFO
PDM_LOG_FORMAT=json
PDM_LOG_TRACE_ID=true

# Metrics & Observability
PDM_METRICS_ENABLED=true
PDM_METRICS_PORT=9090
PDM_METRICS_PREFIX=pdm
PDM_TRACING_ENABLED=false
PDM_JAEGER_HOST=localhost
PDM_JAEGER_PORT=6831
